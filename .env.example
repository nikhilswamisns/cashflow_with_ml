ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here
ZOHO_ORG_ID=your_zoho_organization_id_here
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com/books/v3

# Database configuration (Defaults to data/cashflow.db if omitted)
# DATABASE_PATH=/path/to/custom/cashflow.db

# Folder where the Zoho data behind each forecast run (and each export) is archived.
# Absolute path, or relative to the project folder. Defaults to <project>/zoho_data_archive if omitted.
# ZOHO_ARCHIVE_DIR=zoho_data_archive
# ZOHO_ARCHIVE_DIR=D:\Finance\Gutster\Cashflow Zoho Archive
